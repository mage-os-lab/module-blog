<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <!--<head>-->
        <!--
            Order matters: blog-cards.css declares the design tokens and the
            base .mageos-blog typography that blog.css consumes.
            For luma themes the styles are included by the _module.less system.
        -->
    <!--
        <css src="MageOS_Blog::css/blog-cards.css"/>
        <css src="MageOS_Blog::css/blog.css"/>
    </head>-->
    <body>
        <!--
            Registers the breadcrumb trail. Every blog page handle includes
            blog_default, so this is declared once. The block renders nothing
            and does nothing when the theme has no `breadcrumbs` block.
        -->
        <referenceContainer name="content">
            <block class="MageOS\Blog\Block\Breadcrumbs" name="mageos_blog.breadcrumbs"/>
        </referenceContainer>
    </body>
</page>
