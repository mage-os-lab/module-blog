<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\UrlRewriteGraphQl\Model\Resolver\UrlRewrite\CustomUrlLocator">
        <arguments>
            <argument name="urlLocators" xsi:type="array">
                <item name="blog_post" xsi:type="object">MageOS\Blog\Model\Resolver\UrlResolver\BlogPost</item>
                <item name="blog_category" xsi:type="object">MageOS\Blog\Model\Resolver\UrlResolver\BlogCategory</item>
                <item name="blog_tag" xsi:type="object">MageOS\Blog\Model\Resolver\UrlResolver\BlogTag</item>
                <item name="blog_author" xsi:type="object">MageOS\Blog\Model\Resolver\UrlResolver\BlogAuthor</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\UrlRewriteGraphQl\Model\DataProvider\EntityDataProviderComposite">
        <arguments>
            <argument name="dataProviders" xsi:type="array">
                <item name="blog_post" xsi:type="object">MageOS\Blog\Model\Resolver\UrlResolver\BlogEntityDataProvider</item>
                <item name="blog_category" xsi:type="object">MageOS\Blog\Model\Resolver\UrlResolver\BlogEntityDataProvider</item>
                <item name="blog_tag" xsi:type="object">MageOS\Blog\Model\Resolver\UrlResolver\BlogEntityDataProvider</item>
                <item name="blog_author" xsi:type="object">MageOS\Blog\Model\Resolver\UrlResolver\BlogEntityDataProvider</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\UrlRewriteGraphQl\Model\RoutableInterfaceTypeResolver">
        <arguments>
            <argument name="productTypeNameResolvers" xsi:type="array">
                <item name="blog" xsi:type="object">MageOS\Blog\Model\Resolver\UrlResolver\RoutableTypeResolver</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\UrlRewriteGraphQl\Model\Resolver\EntityUrl">
        <plugin name="mageos_blog_hide_unreadable_entity_url"
                type="MageOS\Blog\Plugin\Magento\UrlRewriteGraphQl\Model\Resolver\EntityUrl"/>
    </type>
    <type name="Magento\UrlRewriteGraphQl\Model\Resolver\Route">
        <plugin name="mageos_blog_route_hide_unreadable_entity"
                type="MageOS\Blog\Plugin\Magento\UrlRewriteGraphQl\Model\Resolver\Route"/>
    </type>
</config>
